# Copy to .env in this folder (archimatebrowser.bat install does it);
# archimatebrowser.bat start then passes it to server\serve.py.
# The file is only read and is not committed.

# X-API-Key the proxy adds to every request to the API. Recommended: a key
# with the role "reader" (see "API keys and roles" in the API's README);
# Import XMI and Delete model are then not offered.
ARCHIXMI_API_KEY=change-me
